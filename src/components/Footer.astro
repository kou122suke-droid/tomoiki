---
import { event } from "../data/site";
import Logo from "./Logo.astro";

const links = [
  { label: "プライバシーポリシー", href: "/privacy/" },
  { label: "運営団体", href: event.organizerUrl },
  { label: "お問い合わせ", href: event.inquiryUrl },
];

const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<footer id="organizer" class="bg-brand-800 py-10 text-white/90">
  <div class="container-lp flex flex-col items-center gap-7 md:flex-row md:justify-between">
    <Logo variant="light" />

    <ul class="flex flex-wrap items-center justify-center gap-x-7 gap-y-2">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            target={isExternal(l.href) ? "_blank" : undefined}
            rel={isExternal(l.href) ? "noopener noreferrer" : undefined}
            class="text-xs font-bold transition-colors hover:text-pop-yellow"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <p class="container-lp mt-8 border-t border-white/15 pt-5 text-center text-[11px] text-white/60">
    © 2026 {event.organizerLegal}. All rights reserved.
  </p>
</footer>
