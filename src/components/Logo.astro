---
import { Image } from "astro:assets";
import { event } from "../data/site";
import markDark from "../assets/logo-asj.png";
import markLight from "../assets/logo-asj-white.png";

interface Props {
  /** light = 濃色背景用（白抜きロゴ） */
  variant?: "dark" | "light";
  class?: string;
}
const { variant = "dark", class: className = "" } = Astro.props;

const mark = variant === "light" ? markLight : markDark;
const sub = variant === "light" ? "rgba(255,255,255,.85)" : "#4a6480";
---

<a
  href="/"
  class:list={["group inline-flex items-center gap-3", className]}
  aria-label={`${event.organizer} ホームへ`}
>
  <Image
    src={mark}
    alt=""
    widths={[88, 176]}
    sizes="44px"
    class="h-11 w-auto shrink-0 transition-transform duration-200 group-hover:scale-105"
  />

  <span class="leading-tight">
    <span class="block text-[10px] font-bold tracking-tight" style={`color:${sub}`}>
      {event.organizerTagline}
    </span>
    <span class="block text-[11px] font-bold tracking-tight" style={`color:${sub}`}>
      {event.organizer}
    </span>
  </span>
</a>
