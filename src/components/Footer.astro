---
import { event } from "../data/site";
import Logo from "./Logo.astro";

const links = [
  { label: "プライバシーポリシー", href: "#" },
  { label: "運営団体", href: "#organizer" },
  { label: "お問い合わせ", href: "#organizer" },
];

const socials = [
  {
    label: "YouTube",
    href: "#",
    path: "M23 12s0-3.8-.5-5.6a2.9 2.9 0 0 0-2-2C18.7 4 12 4 12 4s-6.7 0-8.5.4a2.9 2.9 0 0 0-2 2C1 8.2 1 12 1 12s0 3.8.5 5.6a2.9 2.9 0 0 0 2 2C5.3 20 12 20 12 20s6.7 0 8.5-.4a2.9 2.9 0 0 0 2-2C23 15.8 23 12 23 12ZM9.8 15.4V8.6l5.8 3.4-5.8 3.4Z",
  },
  {
    label: "Instagram",
    href: "#",
    path: "M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4 1.3-.1 1.7-.1 4.9-.1Zm0 5.8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm0 6.6a2.6 2.6 0 1 1 0-5.2 2.6 2.6 0 0 1 0 5.2Zm5.1-6.7a.94.94 0 1 1-1.9 0 .94.94 0 0 1 1.9 0Z",
  },
  {
    label: "X",
    href: "#",
    path: "M17.5 3h3.1l-6.8 7.8L21.8 21h-6.2l-4.9-6.4L5.1 21H2l7.3-8.3L2.3 3h6.4l4.4 5.8L17.5 3Zm-1.1 16.1h1.7L7.7 4.8H5.9l10.5 14.3Z",
  },
];
---

<footer id="organizer" class="bg-brand-800 py-10 text-white/90">
  <div class="container-lp flex flex-col items-center gap-7 md:flex-row md:justify-between">
    <Logo variant="light" />

    <div class="flex flex-col items-center gap-5 sm:flex-row sm:gap-8">
      <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        {links.map((l) => (
          <li>
            <a href={l.href} class="text-xs font-bold transition-colors hover:text-pop-yellow">{l.label}</a>
          </li>
        ))}
      </ul>

      <ul class="flex items-center gap-3">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              aria-label={s.label}
              class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-white/25"
            >
              <svg viewBox="0 0 24 24" class="h-4.5 w-4.5 fill-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <path d={s.path} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <p class="container-lp mt-8 border-t border-white/15 pt-5 text-center text-[11px] text-white/60">
    © 2026 {event.organizer}. All rights reserved.
  </p>
</footer>
