---
import { Image } from "astro:assets";
import { logoFor } from "../lib/schoolMedia";

interface Props {
  slug: string;
  name: string;
  class?: string;
}
const { slug, name, class: className = "" } = Astro.props;
const logo = logoFor(slug);
---

{
  logo?.kind === "image" ? (
    <Image
      src={logo.src}
      alt={`${name} のロゴ`}
      widths={[220, 440]}
      sizes="220px"
      class:list={["object-contain", className]}
    />
  ) : logo?.kind === "url" ? (
    <img src={logo.src} alt={`${name} のロゴ`} class:list={["object-contain", className]} />
  ) : null
}
