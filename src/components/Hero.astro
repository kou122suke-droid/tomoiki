---
import { event } from "../data/site";
import CtaButton from "./CtaButton.astro";

const confetti = [
  { l: "5%",  t: "16%", c: "#ffd23f", s: 20, r: 18 },
  { l: "12%", t: "58%", c: "#ef4b8d", s: 15, r: -22 },
  { l: "20%", t: "6%",  c: "#5cbf4a", s: 17, r: 40 },
  { l: "28%", t: "88%", c: "#8b5cf6", s: 13, r: -8 },
  { l: "36%", t: "76%", c: "#21b6e8", s: 14, r: 10 },
  { l: "45%", t: "4%",  c: "#f97316", s: 16, r: -30 },
  { l: "54%", t: "92%", c: "#5cbf4a", s: 13, r: 48 },
  { l: "62%", t: "84%", c: "#ffd23f", s: 18, r: 25 },
  { l: "70%", t: "12%", c: "#8b5cf6", s: 15, r: -12 },
  { l: "79%", t: "68%", c: "#5cbf4a", s: 17, r: 33 },
  { l: "87%", t: "26%", c: "#ef4b8d", s: 16, r: -40 },
  { l: "94%", t: "56%", c: "#21b6e8", s: 14, r: 15 },
];
---

<section id="top" class="relative isolate overflow-hidden pt-16 md:pt-[4.5rem]">
  <!-- 背景 -->
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(160deg,#d9f0ff_0%,#fff3d9_38%,#ffe3ef_66%,#e2f7e0_100%)]"></div>
  <div
    class="absolute inset-0 -z-10 opacity-70"
    style="background-image:radial-gradient(closest-side at 18% 28%, rgba(33,182,232,.45), transparent), radial-gradient(closest-side at 82% 22%, rgba(255,210,63,.5), transparent), radial-gradient(closest-side at 72% 82%, rgba(239,75,141,.35), transparent), radial-gradient(closest-side at 26% 84%, rgba(92,191,74,.35), transparent);"
  >
  </div>

  <!-- 紙吹雪 -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    {confetti.map((c, i) => (
      <span
        class:list={["absolute block rounded-[3px]", i % 2 ? "animate-float" : "animate-float-slow"]}
        style={`left:${c.l};top:${c.t};width:${c.s}px;height:${c.s * 0.62}px;background:${c.c};transform:rotate(${c.r}deg);animation-delay:${i * 0.32}s;opacity:.85`}
      ></span>
    ))}
  </div>

  <div class="container-lp relative pb-14 pt-8 md:pb-20 md:pt-12">
    <!-- 左上のリボン -->
    <div class="absolute left-0 top-3 hidden w-[11.5rem] -rotate-6 rounded-2xl bg-pop-yellow px-4 py-3 text-center shadow-[0_8px_0_-2px_#e0a107] lg:block xl:-left-4">
      <p class="text-[13px] font-bold leading-snug text-brand-800">
        気になるスクールと<br />直接話せる！
      </p>
      <p class="mt-1.5 border-t border-brand-800/20 pt-1.5 text-[11px] font-bold leading-snug text-brand-700">
        1日最大3校／2日間で<br />最大6校と出会える！
      </p>
    </div>

    <!-- 右上のオンラインバッジ -->
    <div class="absolute right-2 top-4 hidden lg:block xl:right-0">
      <div class="animate-float-slow rounded-full bg-pop-pink p-1.5 shadow-pop">
        <div class="flex h-32 w-32 flex-col items-center justify-center rounded-full border-[3px] border-dashed border-white/70 text-center">
          <span class="rounded-md bg-brand-900 px-2.5 py-0.5 text-[11px] font-bold tracking-widest text-white">ONLINE</span>
          <span class="mt-1.5 text-[13px] font-bold leading-tight text-white">自宅から<br />参加OK！</span>
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-3xl text-center">
      <p class="reveal is-visible text-lg font-bold leading-relaxed text-brand-800 sm:text-xl md:text-2xl">
        学校は、ひとつじゃない。<br class="sm:hidden" />学び方も、ひとつじゃない。
      </p>

      <p class="mt-3 inline-block rounded-full bg-white/80 px-5 py-1.5 text-xs font-bold text-brand-700 shadow-sm sm:text-sm">
        {event.lead}
      </p>

      <!-- タイトル -->
      <h1 class="mt-5 md:mt-6">
        <span class="sr-only">オルスクフェス2026 @ONLINE</span>
        <span aria-hidden="true" class="block">
          <span class="hero-word text-[clamp(2.9rem,11vw,6.4rem)] font-black leading-[1.04] tracking-tight">
            <span class="hw-stroke">オルスクフェス</span>
            <span class="hw-fill">オルスクフェス</span>
          </span>
          <span class="mt-1 flex items-end justify-center gap-2 md:gap-3">
            <span class="hero-word text-[clamp(3.4rem,13vw,7.4rem)] font-black leading-[1.02] tracking-tight">
              <span class="hw-stroke">2026</span>
              <span class="hw-fill">2026</span>
            </span>
            <span class="mb-2 rounded-xl bg-pop-pink px-2.5 py-1 text-[clamp(.85rem,2.6vw,1.4rem)] font-black text-white shadow-[0_5px_0_-1px_#b82d68] md:mb-4">
              @ONLINE
            </span>
          </span>
        </span>
      </h1>

      <p class="mt-3 text-sm font-bold text-brand-700 sm:text-base md:text-lg">{event.catch}</p>

      <!-- 日付 -->
      <div class="mt-6 flex items-center justify-center gap-3 sm:gap-6">
        {event.dates.map((d, i) => (
          <>
            {i > 0 && <span class="text-3xl font-black text-brand-300 sm:text-5xl">/</span>}
            <span class="flex items-end gap-1">
              <span
                class:list={[
                  "text-[clamp(2.4rem,9vw,4.5rem)] font-black leading-none tracking-tight",
                  d.color === "brand" ? "text-brand-600" : "text-pop-pink",
                ]}
              >
                {d.day}
              </span>
              <span
                class:list={[
                  "mb-1.5 flex h-7 w-7 items-center justify-center rounded-full text-sm font-bold text-white sm:mb-2.5 sm:h-9 sm:w-9 sm:text-base",
                  d.color === "brand" ? "bg-brand-600" : "bg-pop-pink",
                ]}
              >
                {d.wd}
              </span>
            </span>
          </>
        ))}
      </div>

      <p class="mx-auto mt-5 inline-flex items-center gap-2 rounded-full bg-brand-800 px-5 py-2 text-xs font-bold text-white shadow-card sm:text-sm">
        {event.timeNote}
      </p>

      <div class="mt-8 flex flex-col items-center gap-3">
        <CtaButton href={event.applyUrl} size="lg">今すぐ参加を申し込む</CtaButton>
        <p class="text-xs font-bold text-brand-700/80">※定員100名・先着順／定員に達し次第、受付を終了します。</p>
      </div>
    </div>

    <!-- 右下のひとこと -->
    <p class="absolute bottom-4 right-3 hidden w-36 rotate-3 text-center text-sm font-bold leading-snug text-brand-700 xl:block">
      新しい教育に、<br /><span class="text-accent-600">ワクワクする<br />2日間を！</span>
    </p>
  </div>

  <!-- 下端の波 -->
  <svg class="block w-full" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <path d="M0 30 Q 180 60 360 34 T 720 30 T 1080 34 T 1440 26 L1440 60 L0 60Z" fill="#fdf8ef" />
  </svg>
</section>
