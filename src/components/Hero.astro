---
import { getImage } from "astro:assets";
import { event } from "../data/site";
import CtaButton from "./CtaButton.astro";
import banner from "../assets/hero-banner.jpg";
import bannerSp from "../assets/hero-banner-sp.jpg";

/**
 * メインビジュアルは元データ(1737x766)が上限。
 * アップスケールせずに済むよう、元幅を最大値としたバリエーションを書き出す。
 * スマホはアートディレクションを変えて中央トリミング版を配信する。
 */
const pcWidths = [banner.width, 1400, 1100, 860];
const spWidths = [bannerSp.width, 780, 620, 460];
// JPEG は AVIF/WebP 非対応ブラウザ向けのフォールバックなので本数を絞る
const pcJpgWidths = [1400, 860];
const spJpgWidths = [780, 460];
const sizes = "100vw";

const [pcAvif, pcWebp, pcJpg, spAvif, spWebp, spJpg] = await Promise.all([
  getImage({ src: banner, widths: pcWidths, sizes, format: "avif", quality: 68 }),
  getImage({ src: banner, widths: pcWidths, sizes, format: "webp", quality: 82 }),
  getImage({ src: banner, widths: pcJpgWidths, sizes, format: "jpeg", quality: 84 }),
  getImage({ src: bannerSp, widths: spWidths, sizes, format: "avif", quality: 68 }),
  getImage({ src: bannerSp, widths: spWidths, sizes, format: "webp", quality: 82 }),
  getImage({ src: bannerSp, widths: spJpgWidths, sizes, format: "jpeg", quality: 84 }),
]);

const SP = "(max-width: 767px)";

const facts = [
  { label: "開催日", value: "2026.9.26（土）・9.27（日）" },
  { label: "時間", value: "両日 9:00 - 12:00" },
  { label: "形式", value: "オンライン（Zoom）" },
  { label: "参加費", value: "1,000円（両日参加可）" },
];
---

<section id="top" class="relative isolate overflow-hidden pt-16 md:pt-[4.5rem]">
  <!-- 背景（バナー左右の余白を埋める） -->
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(160deg,#1b1140_0%,#3b1a6b_40%,#7b1f6a_70%,#c02a63_100%)]"></div>

  <h1 class="sr-only">
    オルスクフェス2026 @ONLINE ｜ 全国のオルタナティブスクールと出会う2日間。2026年9月26日(土)・27日(日)
    9:00-12:00、オンライン（Zoom）開催。
  </h1>

  <!-- メインビジュアル -->
  <div class="mx-auto w-full max-w-[2000px]">
    <picture>
      <source media={SP} type="image/avif" srcset={spAvif.srcSet.attribute} sizes={sizes} />
      <source media={SP} type="image/webp" srcset={spWebp.srcSet.attribute} sizes={sizes} />
      <source media={SP} type="image/jpeg" srcset={spJpg.srcSet.attribute} sizes={sizes} />
      <source type="image/avif" srcset={pcAvif.srcSet.attribute} sizes={sizes} />
      <source type="image/webp" srcset={pcWebp.srcSet.attribute} sizes={sizes} />
      <img
        src={pcJpg.src}
        srcset={pcJpg.srcSet.attribute}
        sizes={sizes}
        width={banner.width}
        height={banner.height}
        alt=""
        aria-hidden="true"
        fetchpriority="high"
        decoding="async"
        class="block aspect-[975/766] w-full object-cover md:aspect-[1737/766]"
      />
    </picture>
  </div>

  <!-- 開催情報 + CTA -->
  <div class="container-lp pb-12 pt-8 md:pb-16 md:pt-10">
    <dl class="mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-2.5 sm:gap-3">
      {facts.map((f) => (
        <div class="flex items-center gap-2 rounded-full bg-white/95 px-4 py-1.5 shadow-card backdrop-blur-sm">
          <dt class="text-[11px] font-bold text-white bg-brand-700 rounded-full px-2 py-0.5">{f.label}</dt>
          <dd class="text-[12.5px] font-bold text-brand-800 sm:text-sm">{f.value}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-7 flex flex-col items-center gap-3">
      <CtaButton href={event.applyUrl} size="lg">今すぐ参加を申し込む</CtaButton>
      <p class="text-xs font-bold text-white/80">※定員100名・先着順／定員に達し次第、受付を終了します。</p>
    </div>
  </div>

  <!-- 下端の波 -->
  <svg class="block w-full" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <path d="M0 30 Q 180 60 360 34 T 720 30 T 1080 34 T 1440 26 L1440 60 L0 60Z" fill="#fdf8ef" />
  </svg>
</section>
