---
import SchoolScene from "./SchoolScene.astro";
import SchoolLogo from "./SchoolLogo.astro";
import Icon from "./Icon.astro";
import { schools } from "../data/schools";
import { photosFor, hasLogo } from "../lib/schoolMedia";
import { Image } from "astro:assets";

const cards = schools.map((s) => ({ school: s, cover: photosFor(s.slug)[0], logo: hasLogo(s.slug) }));
---

<section id="schools" class="bg-cream py-16 md:py-24">
  <div class="container-lp">
    <h2 class="reveal text-center text-2xl font-bold text-brand-700 sm:text-3xl md:text-[2.15rem]">
      参加スクール
      <span class="mx-1 text-[1.5em] leading-none text-accent-500">{schools.length}</span>
      校
    </h2>
    <p class="reveal mt-3 text-center text-sm text-ink-soft sm:text-base">
      全国から個性豊かなオルタナティブスクールが参加します！
      <br class="sm:hidden" />
      <span class="text-brand-600">カードをタップすると詳細をご覧いただけます。</span>
    </p>

    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map(({ school, cover, logo }, i) => (
        <li class="reveal" style={`transition-delay:${(i % 3) * 80}ms`}>
          <a
            href={`/schools/${school.slug}/`}
            class="group flex h-full flex-col overflow-hidden rounded-3xl bg-white shadow-card transition-all duration-300 hover:-translate-y-1.5 hover:shadow-pop"
          >
            <div class="relative overflow-hidden">
              {cover ? (
                <Image
                  src={cover}
                  alt=""
                  widths={[420, 840]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  loading="lazy"
                  class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.06]"
                />
              ) : (
                <SchoolScene
                  variant={school.scene}
                  class="aspect-[16/10] w-full transition-transform duration-500 group-hover:scale-[1.06]"
                />
              )}
              <span class="absolute left-3 top-3 rounded-full bg-white/95 px-2.5 py-0.5 text-[10px] font-bold text-brand-700 shadow-sm">
                {school.pref}
              </span>
            </div>

            <div class="flex flex-1 flex-col p-4">
              <div class="flex items-start gap-3">
                {logo && (
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-brand-50 p-1">
                    <SchoolLogo slug={school.slug} name={school.name} class="max-h-full max-w-full" />
                  </span>
                )}
                <h3 class="flex-1 text-[13.5px] font-bold leading-snug text-brand-800">
                  {school.cardName.split("\n").map((line, li) => (
                    <>{li > 0 && <br />}{line}</>
                  ))}
                </h3>
              </div>

              <p class="mt-3 line-clamp-2 text-[12.5px] font-bold leading-snug text-accent-600">
                {school.catch}
              </p>
              <p class="mt-2 line-clamp-3 flex-1 text-xs leading-relaxed text-ink-soft">
                {school.summary}
              </p>

              <span class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-brand-600">
                くわしく見る
                <Icon name="arrow" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" />
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
