---
import { url } from "../lib/url";
import { Image } from "astro:assets";
import { event } from "../data/site";
import lockupDark from "../assets/logo-asj-lockup.png";
import lockupLight from "../assets/logo-asj-lockup-white.png";

interface Props {
  /** light = 濃色背景用（白抜きロゴ） */
  variant?: "dark" | "light";
  class?: string;
}
const { variant = "dark", class: className = "" } = Astro.props;

// ロゴ自体に団体名が入っているため、横にテキストは置かない
const lockup = variant === "light" ? lockupLight : lockupDark;
---

<a
  href={url("/")}
  class:list={["inline-flex shrink-0 items-center", className]}
  aria-label={`${event.organizer} ホームへ`}
>
  <Image
    src={lockup}
    alt={event.organizer}
    widths={[220, 440]}
    sizes="(min-width: 640px) 220px, 180px"
    class="h-9 w-auto transition-opacity duration-200 hover:opacity-80 sm:h-10"
  />
</a>
