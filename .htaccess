# ── https / www なしに統一（no-limit.life 本体だけに適用し、サブドメインには影響させない） ──
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.no-limit\.life$ [NC]
RewriteRule ^(.*)$ https://no-limit.life/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^no-limit\.life$ [NC]
RewriteCond %{HTTPS} !on
RewriteRule ^(.*)$ https://no-limit.life/$1 [R=301,L]

# ── 存在しないページは 404.html を表示 ──
ErrorDocument 404 /404.html

# ── 文字コード・動画の種類 ──
AddDefaultCharset UTF-8
AddType video/mp4 .mp4

# ── 圧縮 ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# ── ブラウザキャッシュ（HTMLは毎回最新を確認、画像・動画は長め） ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
