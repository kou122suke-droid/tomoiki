---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CtaButton from "../components/CtaButton.astro";
import { url } from "../lib/url";
import { event } from "../data/site";
---

<Base title={`ページが見つかりません｜${event.title}${event.titleSub}`} description="お探しのページは見つかりませんでした。">
  <Header />

  <main id="main" class="bg-[linear-gradient(150deg,#eaf4ff_0%,#fdf8ef_60%,#ffeef5_100%)] pt-16 md:pt-[4.5rem]">
    <div class="container-lp flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
      <p class="text-[clamp(3.5rem,12vw,7rem)] font-black leading-none text-brand-200">404</p>
      <h1 class="mt-4 text-xl font-bold text-brand-800 sm:text-2xl">
        お探しのページが見つかりませんでした
      </h1>
      <p class="mt-3 text-sm leading-relaxed text-ink-soft">
        URLが変更されたか、削除された可能性があります。
      </p>

      <div class="mt-9 flex flex-col items-center gap-4 sm:flex-row">
        <CtaButton href={event.applyUrl}>今すぐ参加を申し込む</CtaButton>
        <a
          href={url("/")}
          class="rounded-full border-2 border-brand-500 px-6 py-3 text-sm font-bold text-brand-600 transition-colors hover:bg-brand-600 hover:text-white"
        >
          トップページへ戻る
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Base>
