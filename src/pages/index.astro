---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Worries from "../components/Worries.astro";
import Features from "../components/Features.astro";
import Schools from "../components/Schools.astro";
import Program from "../components/Program.astro";
import Overview from "../components/Overview.astro";
import Recommend from "../components/Recommend.astro";
import Faq from "../components/Faq.astro";
