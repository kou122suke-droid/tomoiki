---
import { timetable } from "../data/site";
---

<section id="program" class="bg-white py-16 md:py-24">
  <div class="container-lp">
    <h2 class="reveal text-center text-2xl font-bold text-brand-700 sm:text-3xl md:text-[2.15rem]">
      プログラム・タイムテーブル
    </h2>
    <p class="reveal mt-3 text-center text-sm text-ink-soft sm:text-base">
      2日間で、たくさんのスクールと出会えるプログラムを用意しています。
    </p>

    <div class="mt-10 grid gap-8 lg:grid-cols-[1.35fr_1fr] lg:items-start">
      <div class="reveal grid gap-6 sm:grid-cols-2">
        {timetable.map((day) => (
          <div class="rounded-4xl bg-cream p-5 shadow-card sm:p-6">
            <p class="flex items-end gap-1.5 border-b-2 border-dashed border-brand-200 pb-3">
              <span
                class:list={[
                  "text-3xl font-black leading-none sm:text-[2.1rem]",
                  day.tone === "brand" ? "text-brand-600" : "text-pop-pink",
                ]}
              >
                {day.date}
              </span>
              <span
                class:list={[
                  "mb-0.5 text-base font-bold",
                  day.tone === "brand" ? "text-brand-600" : "text-pop-pink",
                ]}
              >
                （{day.wd}）
              </span>
            </p>

            <ol class="mt-3 space-y-0.5">
              {day.rows.map((r) => (
                <li class="flex items-baseline gap-3 rounded-lg px-2 py-2 transition-colors hover:bg-white">
                  <span
                    class:list={[
                      "w-12 shrink-0 text-sm font-bold tabular-nums",
                      day.tone === "brand" ? "text-brand-500" : "text-pop-pink",
                    ]}
                  >
                    {r.time}
                  </span>
                  <span class="text-[13.5px] font-bold leading-snug text-brand-800 sm:text-[14.5px]">{r.label}</span>
                </li>
              ))}
            </ol>
          </div>
        ))}
        <p class="text-center text-xs text-ink-soft sm:col-span-2">※プログラムは変更になる場合があります。</p>
      </div>

      <!-- ビジュアル -->
      <figure class="reveal relative overflow-hidden rounded-4xl shadow-pop lg:h-full lg:min-h-[26rem]">
        <svg viewBox="0 0 480 400" class="h-full w-full" preserveAspectRatio="xMidYMid slice" role="img" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="pg-sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#9fd8f7" />
              <stop offset="60%" stop-color="#d9f0ff" />
              <stop offset="100%" stop-color="#f4fbe8" />
            </linearGradient>
          </defs>
          <rect width="480" height="400" fill="url(#pg-sky)" />
          <circle cx="392" cy="72" r="38" fill="#ffd23f" opacity="0.9" />
          <g fill="#ffffff" opacity="0.92">
            <ellipse cx="92" cy="74" rx="46" ry="22" />
            <ellipse cx="128" cy="62" rx="32" ry="19" />
            <ellipse cx="268" cy="50" rx="36" ry="17" />
          </g>
          <path d="M-20 268 Q 120 196 260 262 T 500 232 L500 400 L-20 400Z" fill="#8fd07a" />
          <path d="M-20 300 Q 140 250 300 300 T 500 288 L500 400 L-20 400Z" fill="#63b85c" />
          {[44, 434].map((x, i) => (
            <g transform={`translate(${x} ${292 + i * 8})`}>
              <rect x="-7" y="-30" width="14" height="40" fill="#8b5a2b" />
              <circle cx="0" cy="-46" r="34" fill="#4f9a4c" />
              <circle cx="-22" cy="-30" r="22" fill="#63b85c" />
              <circle cx="22" cy="-30" r="22" fill="#63b85c" />
            </g>
          ))}
          {[
            { x: 168, c: "#ef4b8d", s: 1.0 },
            { x: 244, c: "#ffd23f", s: 1.18 },
            { x: 320, c: "#21b6e8", s: 1.04 },
          ].map((k) => (
            <g transform={`translate(${k.x} 330) scale(${k.s})`}>
              <rect x="-15" y="-62" width="30" height="42" rx="13" fill={k.c} />
              <circle cx="0" cy="-76" r="17" fill="#f6d3ad" />
              <path d="M-17 -76 a17 17 0 0 0 34 0 q-8.5 -8.5 -17 -8.5 t-17 8.5Z" fill="#41332b" />
              <rect x="-11" y="-22" width="9" height="24" rx="4.5" fill="#3f4b5c" />
              <rect x="3" y="-22" width="9" height="24" rx="4.5" fill="#3f4b5c" />
              <rect x="-27" y="-60" width="12" height="30" rx="6" fill={k.c} transform="rotate(-30 -21 -50)" />
              <rect x="15" y="-60" width="12" height="30" rx="6" fill={k.c} transform="rotate(30 21 -50)" />
            </g>
          ))}
        </svg>
        <figcaption class="absolute inset-x-0 top-0 p-6 text-center">
          <span class="inline-block rounded-2xl bg-white/85 px-5 py-3 text-[15px] font-bold leading-relaxed text-brand-800 shadow-sm backdrop-blur-sm sm:text-lg">
            新しい学びと出会うことで、<br />きっと、子どもの未来は変わる。
          </span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
