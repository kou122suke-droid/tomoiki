# さくらのレンタルサーバの接続情報（コピーして .env.sakura を作成してください）
# .env.sakura は .gitignore 済みなのでコミットされません。

# サーバコントロールパネルの「サーバ情報の表示」で確認できます
SAKURA_USER=example
SAKURA_HOST=example.sakura.ne.jp

# 公開ディレクトリ。独自ドメインをサブディレクトリに割り当てている場合は
# /home/example/www/fes2026 のように指定します。
SAKURA_PATH=/home/example/www

# ssh = rsync で転送（スタンダードプラン以上）
# ftp = lftp で転送（ライトプラン）
METHOD=ssh

# METHOD=ftp のときだけ必要
#SAKURA_PASS=
